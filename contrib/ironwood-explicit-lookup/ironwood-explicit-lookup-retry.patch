@@ -0,0 +1,82 @@
+package network
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"testing"
+	"time"
+)
+
+// Regression through public SendLookup and real signed path notifications.
+// No application data/write/retry, warmup, TUN, root, socket or WAN. Peering
+// uses the repository's existing in-memory reliable ordered connection fixture.
+func TestExplicitLookupFreshPeer(t *testing.T) {
+	t.Log("[1/3] entry TestExplicitLookupFreshPeer processed=0/3 remaining=3")
+	started := time.Now()
+	defer func() {
+		t.Logf("[3/3] final processed=3/3 errors=testing elapsed=%s speed=%.2fstages/s", time.Since(started), 3/time.Since(started).Seconds())
+	}()
+	pubA, privA, err := ed25519.GenerateKey(nil)
+	if err != nil {
+		t.Fatal("first fixture key generation failed")
+	}
+	pubB, privB, err := ed25519.GenerateKey(nil)
+	if err != nil {
+		t.Fatal("second fixture key generation failed")
+	}
+	ready := make(chan struct{}, 1)
+	a, err := NewPacketConn(privA, WithPathNotify(func(key ed25519.PublicKey) {
+		if bytes.Equal(key, pubB) {
+			select {
+			case ready <- struct{}{}:
+			default:
+			}
+		}
+	}))
+	if err != nil {
+		t.Fatal("first packet connection failed")
+	}
+	b, err := NewPacketConn(privB)
+	if err != nil {
+		_ = a.Close()
+		t.Fatal("second packet connection failed")
+	}
+	ca, cb := newDummyConn(pubA, pubB)
+	joined := make(chan struct{}, 2)
+	go func() { _ = a.HandleConn(pubB, ca, 0); joined <- struct{}{} }()
+	go func() { _ = b.HandleConn(pubA, cb, 0); joined <- struct{}{} }()
+	t.Cleanup(func() {
+		t.Log("state TestExplicitLookupFreshPeer cleanup")
+		_ = ca.Close()
+		_ = cb.Close()
+		_ = a.Close()
+		_ = b.Close()
+		for i := 0; i < 2; i++ {
+			select {
+			case <-joined:
+			case <-time.After(time.Second):
+				t.Error("owned peer failed to join")
+			}
+		}
+	})
+	deadline := time.Now().Add(3 * time.Second)
+	for len(a.Debug.GetTree()) < 2 || len(b.Debug.GetTree()) < 2 {
+		if time.Now().After(deadline) {
+			t.Fatal("fresh peer/tree readiness failed")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	if len(a.Debug.GetPaths()) != 0 {
+		t.Fatal("path unexpectedly warmed")
+	}
+	t.Logf("[2/3] one public SendLookup processed=1/3 remaining=2 elapsed=%s ETA<=6s", time.Since(started))
+	a.SendLookup(pubB)
+	select {
+	case <-ready:
+		if len(a.Debug.GetPaths()) != 1 {
+			t.Fatal("notify arrived without resolved path")
+		}
+	case <-time.After(6 * time.Second):
+		t.Fatal("single cold explicit lookup never retried after fresh peer convergence")
+	}
+}
diff --git a/network/lookup_retry.go b/network/lookup_retry.go
new file mode 100644
index 0000000..f6e8ecf
--- /dev/null
+++ b/network/lookup_retry.go
@@ -0,0 +1,64 @@
+package network
+
+import (
+	"log/slog"
+	"time"
+)
+
+const explicitLookupRetries = 2
+
+// Actor ownership, existing rumor admission/TTL and existing maintenance timer
+// bound this retry. Remote traffic never creates explicit pending state. No
+// additional timer, packet buffer, map entry, wire field or crypto change.
+func (pf *pathfinder) _startExplicitLookup(dest publicKey) {
+	slog.Debug("entry pathfinder _startExplicitLookup")
+	defer slog.Debug("exit pathfinder _startExplicitLookup")
+	slog.Debug("external initial explicit lookup through existing rumor admission")
+	pf._rumorSendLookup(dest)
+	xform := pf.router.blooms.xKey(dest)
+	rumor, ok := pf.rumors[xform]
+	if !ok {
+		slog.Error("explicit lookup state missing")
+		return
+	}
+	if rumor.lookupStarted {
+		slog.Debug("result explicit lookup already admitted")
+		return
+	}
+	rumor.lookupTarget = dest
+	rumor.lookupStarted, rumor.lookupPending = true, true
+	pf.rumors[xform] = rumor
+	slog.Debug("state explicit lookup pending")
+}
+
+func (pf *pathfinder) _retryExplicitLookups() {
+	slog.Debug("entry pathfinder _retryExplicitLookups")
+	defer slog.Debug("exit pathfinder _retryExplicitLookups")
+	for xform, rumor := range pf.rumors {
+		if !rumor.lookupPending || rumor.lookupRetries >= explicitLookupRetries {
+			continue
+		}
+		if time.Since(rumor.sendTime) < max(time.Second, pf.router.core.config.pathThrottle) {
+			continue
+		}
+		// Deliberately do NOT reset rumor.timer or admit a new rumor. The
+		// finite retry budget belongs to this existing rumor, not each write.
+		rumor.lookupRetries++
+		rumor.sendTime = time.Now()
+		pf.rumors[xform] = rumor
+		slog.Debug("state explicit lookup retry", "attempt", rumor.lookupRetries)
+		slog.Debug("external resend explicit path lookup")
+		pf._sendLookup(rumor.lookupTarget)
+	}
+}
+
+func (pf *pathfinder) _finishExplicitLookup(dest publicKey) {
+	slog.Debug("entry pathfinder _finishExplicitLookup")
+	defer slog.Debug("exit pathfinder _finishExplicitLookup")
+	xform := pf.router.blooms.xKey(dest)
+	if rumor, ok := pf.rumors[xform]; ok && rumor.lookupPending {
+		rumor.lookupPending = false
+		pf.rumors[xform] = rumor
+		slog.Debug("state explicit lookup resolved")
+	}
+}
diff --git a/network/lookup_retry_test.go b/network/lookup_retry_test.go
new file mode 100644
index 0000000..92f10c0
--- /dev/null
+++ b/network/lookup_retry_test.go
@@ -0,0 +1,260 @@
+package network
+
+import (
+	"crypto/ed25519"
+	"testing"
+	"time"
+
+	"github.com/Arceliar/phony"
+)
+
+func explicitFixture(t *testing.T, opts ...Option) (*PacketConn, map[publicKey]int) {
+	t.Helper()
+	t.Log("entry explicitFixture")
+	defer t.Log("exit explicitFixture")
+	_, key, err := ed25519.GenerateKey(nil)
+	if err != nil {
+		t.Fatal("fixture generation failed")
+	}
+	pc, err := NewPacketConn(key, opts...)
+	if err != nil {
+		t.Fatal("fixture construction failed")
+	}
+	counts := map[publicKey]int{}
+	phony.Block(&pc.core.router, func() {
+		pc.core.router.mainTimer.Stop()
+		pc.core.router.pathfinder.logger = func(lookup *pathLookup) { counts[lookup.dest]++ }
+	})
+	t.Cleanup(func() {
+		t.Log("state explicitFixture cleanup")
+		phony.Block(&pc.core.router, func() {
+			for key, info := range pc.core.router.pathfinder.paths {
+				info.timer.Stop()
+				if info.traffic != nil {
+					freeTraffic(info.traffic)
+				}
+				delete(pc.core.router.pathfinder.paths, key)
+			}
+			for key, rumor := range pc.core.router.pathfinder.rumors {
+				rumor.timer.Stop()
+				if rumor.traffic != nil {
+					freeTraffic(rumor.traffic)
+				}
+				delete(pc.core.router.pathfinder.rumors, key)
+			}
+		})
+		if err := pc.Close(); err != nil && !pc.IsClosed() {
+			t.Error("fixture close failed")
+		}
+	})
+	return pc, counts
+}
+
+func TestExplicitLookupFiniteBudget(t *testing.T) {
+	t.Log("entry TestExplicitLookupFiniteBudget")
+	defer t.Log("exit TestExplicitLookupFiniteBudget")
+	pc, counts := explicitFixture(t)
+	var dest publicKey
+	dest[0] = 1
+	var got [5]int
+	phony.Block(&pc.core.router, func() {
+		pf := &pc.core.router.pathfinder
+		pf._startExplicitLookup(dest)
+		got[0] = counts[dest]
+		for i := 1; i < len(got); i++ {
+			xform := pf.router.blooms.xKey(dest)
+			rumor := pf.rumors[xform]
+			rumor.sendTime = time.Now().Add(-2 * time.Second)
+			pf.rumors[xform] = rumor
+			pf._retryExplicitLookups()
+			got[i] = counts[dest]
+		}
+	})
+	if got != [5]int{1, 2, 3, 3, 3} {
+		t.Fatalf("lookup counts=%v", got)
+	}
+}
+
+func TestExplicitLookupNoBudgetResetByNewWrite(t *testing.T) {
+	t.Log("entry TestExplicitLookupNoBudgetResetByNewWrite")
+	defer t.Log("exit TestExplicitLookupNoBudgetResetByNewWrite")
+	pc, counts := explicitFixture(t)
+	var dest publicKey
+	dest[0] = 2
+	var automatic uint8
+	var got int
+	phony.Block(&pc.core.router, func() {
+		pf := &pc.core.router.pathfinder
+		pf._startExplicitLookup(dest)
+		for i := 0; i < 2; i++ {
+			r := pf.rumors[dest]
+			r.sendTime = time.Now().Add(-2 * time.Second)
+			pf.rumors[dest] = r
+			pf._retryExplicitLookups()
+		}
+		r := pf.rumors[dest]
+		r.sendTime = time.Now().Add(-2 * time.Second)
+		pf.rumors[dest] = r
+		pf._startExplicitLookup(dest) // ordinary caller-requested lookup is allowed
+		r = pf.rumors[dest]
+		r.sendTime = time.Now().Add(-2 * time.Second)
+		pf.rumors[dest] = r
+		pf._retryExplicitLookups()
+		automatic, got = pf.rumors[dest].lookupRetries, counts[dest]
+	})
+	if automatic != 2 || got != 4 {
+		t.Fatalf("automatic=%d all=%d", automatic, got)
+	}
+}
+
+func TestExplicitLookupThrottleFloor(t *testing.T) {
+	t.Log("entry TestExplicitLookupThrottleFloor")
+	defer t.Log("exit TestExplicitLookupThrottleFloor")
+	for _, throttle := range []time.Duration{0, -time.Second, 3 * time.Second} {
+		pc, counts := explicitFixture(t, WithPathThrottle(throttle))
+		var dest publicKey
+		dest[0] = 3
+		var got [3]int
+		phony.Block(&pc.core.router, func() {
+			pf := &pc.core.router.pathfinder
+			pf._startExplicitLookup(dest)
+			for i, age := range []time.Duration{time.Millisecond, max(time.Second, throttle) + time.Second, time.Millisecond} {
+				r := pf.rumors[dest]
+				r.sendTime = time.Now().Add(-age)
+				pf.rumors[dest] = r
+				pf._retryExplicitLookups()
+				got[i] = counts[dest]
+			}
+		})
+		if got != [3]int{1, 2, 2} {
+			t.Fatalf("throttle=%s counts=%v", throttle, got)
+		}
+	}
+}
+
+func TestExplicitLookupTransformedTarget(t *testing.T) {
+	t.Log("entry TestExplicitLookupTransformedTarget")
+	defer t.Log("exit TestExplicitLookupTransformedTarget")
+	pc, counts := explicitFixture(t, WithBloomTransform(func(key ed25519.PublicKey) ed25519.PublicKey {
+		out := make(ed25519.PublicKey, ed25519.PublicKeySize)
+		out[0] = key[0]
+		return out
+	}))
+	var dest publicKey
+	dest[0], dest[1] = 4, 99
+	var correct, incorrect int
+	phony.Block(&pc.core.router, func() {
+		pf := &pc.core.router.pathfinder
+		pf._startExplicitLookup(dest)
+		xform := pf.router.blooms.xKey(dest)
+		r := pf.rumors[xform]
+		r.sendTime = time.Now().Add(-2 * time.Second)
+		pf.rumors[xform] = r
+		pf._retryExplicitLookups()
+		correct, incorrect = counts[dest], counts[xform]
+	})
+	if correct != 2 || incorrect != 0 {
+		t.Fatalf("actual target=%d transformed target=%d", correct, incorrect)
+	}
+}
+
+func TestExplicitLookupSignedNotifyStops(t *testing.T) {
+	t.Log("entry TestExplicitLookupSignedNotifyStops")
+	defer t.Log("exit TestExplicitLookupSignedNotifyStops")
+	pc, counts := explicitFixture(t)
+	pub, key, err := ed25519.GenerateKey(nil)
+	if err != nil {
+		t.Fatal("remote fixture generation failed")
+	}
+	var dest publicKey
+	copy(dest[:], pub)
+	var pendingAfterBad, pendingAfterGood bool
+	var got int
+	phony.Block(&pc.core.router, func() {
+		pf := &pc.core.router.pathfinder
+		pf._startExplicitLookup(dest)
+		notify := pathNotify{source: dest, dest: pc.core.crypto.publicKey, watermark: ^uint64(0), info: pathNotifyInfo{seq: 1}}
+		pf._handleNotify(dest, &notify) // zero signature must not cancel retries
+		pendingAfterBad = pf.rumors[dest].lookupPending
+		notify.info.sign(privateKey(key))
+		pf._handleNotify(dest, &notify)
+		pendingAfterGood = pf.rumors[dest].lookupPending
+		r := pf.rumors[dest]
+		r.sendTime = time.Now().Add(-2 * time.Second)
+		pf.rumors[dest] = r
+		pf._retryExplicitLookups()
+		got = counts[dest]
+	})
+	if !pendingAfterBad || pendingAfterGood || got != 1 {
+		t.Fatalf("badPending=%t goodPending=%t lookups=%d", pendingAfterBad, pendingAfterGood, got)
+	}
+}
+
+func TestExplicitLookupDoesNotExtendExpiry(t *testing.T) {
+	t.Log("entry TestExplicitLookupDoesNotExtendExpiry")
+	defer t.Log("exit TestExplicitLookupDoesNotExtendExpiry")
+	pc, _ := explicitFixture(t, WithPathTimeout(50*time.Millisecond))
+	var dest publicKey
+	dest[0] = 5
+	phony.Block(&pc.core.router, func() {
+		pf := &pc.core.router.pathfinder
+		pf._startExplicitLookup(dest)
+		r := pf.rumors[dest]
+		r.timer.Reset(time.Millisecond)
+		r.sendTime = time.Now().Add(-2 * time.Second)
+		pf.rumors[dest] = r
+		pf._retryExplicitLookups()
+	})
+	deadline := time.Now().Add(time.Second)
+	for {
+		n := 0
+		phony.Block(&pc.core.router, func() { n = len(pc.core.router.pathfinder.rumors) })
+		if n == 0 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("retry extended original rumor expiry")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func TestExplicitLookupRemoteCannotAdmit(t *testing.T) {
+	t.Log("entry TestExplicitLookupRemoteCannotAdmit")
+	defer t.Log("exit TestExplicitLookupRemoteCannotAdmit")
+	pc, _ := explicitFixture(t)
+	var dest, source publicKey
+	dest[0], source[0] = 6, 7
+	var n int
+	phony.Block(&pc.core.router, func() {
+		pf := &pc.core.router.pathfinder
+		pf._handleLookup(source, &pathLookup{source: source, dest: dest})
+		pf._handleNotify(source, &pathNotify{source: source, dest: dest})
+		pf._retryExplicitLookups()
+		n = len(pf.rumors)
+	})
+	if n != 0 {
+		t.Fatal("remote input admitted pending state")
+	}
+}
+
+func TestExplicitLookupUnmarkedRumorNotRetried(t *testing.T) {
+	t.Log("entry TestExplicitLookupUnmarkedRumorNotRetried")
+	defer t.Log("exit TestExplicitLookupUnmarkedRumorNotRetried")
+	pc, counts := explicitFixture(t)
+	var dest publicKey
+	dest[0] = 8
+	var got int
+	phony.Block(&pc.core.router, func() {
+		pf := &pc.core.router.pathfinder
+		pf._rumorSendLookup(dest)
+		r := pf.rumors[dest]
+		r.sendTime = time.Now().Add(-2 * time.Second)
+		pf.rumors[dest] = r
+		pf._retryExplicitLookups()
+		got = counts[dest]
+	})
+	if got != 1 {
+		t.Fatal("non-explicit rumor retried")
+	}
+}
